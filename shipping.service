[Unit]
Description=Shipping Service

[Service]
User=roboshop
WorkingDirectory=/app
Environment=CART_ENDPOINT=cart.satyadaws.online:8080
Environment=DB_HOST=mysql.satyadaws.online
ExecStart=/usr/bin/java -Dspring.datasource.url=jdbc:mysql://mysql.satyadaws.online:3306/cities?allowPublicKeyRetrieval=true&useSSL=false -Dspring.datasource.username=root -Dspring.datasource.password=RoboShop@1 -jar /app/shipping.jar
SyslogIdentifier=shipping
Restart=always

[Install]
WantedBy=multi-user.target